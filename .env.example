GOOGLE_CLIENT_ID=93044469695-jq5ou2ni359kjft4shbu1p659b4e2qm6.apps.googleusercontent.com

# MongoDB Atlas ulanish manzili (mongodb+srv://...). MAJBURIY
MONGODB_URI=Mongodb_url
# Baza nomi (ixtiyoriy)
MONGODB_DB=xaridor

# Uzun tasodifiy qator, kamida 32 belgi. MAJBURIY
JWT_SECRET=secret code

# Telegram: TG_CHAT_ID admin xabarlari va sotuvchi arizalari uchun (pin huquqli guruh tavsiya qilinadi)
TG_BOT_TOKEN=bot_token
TG_CHAT_ID=admin id
# Bot tugmalarini boshqaruvchi adminning shaxsiy Telegram ID si (guruh ishlatilsa majburiy)
TG_ADMIN_ID=admin_id

# Birinchi ishga tushishda shu ma'lumotlar bilan admin yaratiladi
