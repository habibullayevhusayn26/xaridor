PORT=3000

# MongoDB Atlas ulanish manzili (mongodb+srv://...). MAJBURIY
MONGODB_URI=Mongodb_url
# Baza nomi (ixtiyoriy)
MONGODB_DB=xaridor

# Uzun tasodifiy qator, kamida 32 belgi. MAJBURIY
JWT_SECRET=secret code

# Telegram: har bir buyurtma shu botga keladi. IKKALASI HAM MAJBURIY
TG_BOT_TOKEN=bot_token
TG_CHAT_ID=admin id
# Botdan foydalanuvchilarni qidirishga ruxsat berilgan adminning Telegram ID si (ixtiyoriy)
TG_ADMIN_ID=admin_id

# Birinchi ishga tushishda shu ma'lumotlar bilan admin yaratiladi
ADMIN_NAME=Adminú
ADMIN_PHONE=+9980000000
ADMIN_PASSWORD=admin_passw